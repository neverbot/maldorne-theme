<footer id="footer" class="footer">
    <div class="copyright">
        <span><%= config.title %></span>
    </div>
</footer>


<script>
  (function () {
    var facades = document.querySelectorAll('.video-facade');
    if (!facades.length) return;

    var base = '<%- url_for('/vendor/plyr-' + theme.plyr.version + '/') %>';
    var loading;

    function loadPlyr() {
      if (!loading) {
        loading = new Promise(function (resolve, reject) {
          var link = document.createElement('link');
          link.rel = 'stylesheet';
          link.href = base + 'plyr.css';
          document.head.appendChild(link);

          var script = document.createElement('script');
          script.src = base + 'plyr.min.js';
          script.onload = resolve;
          script.onerror = reject;
          document.head.appendChild(script);
        });
      }
      return loading;
    }

    facades.forEach(function (facade) {
      var link = facade.querySelector('.video-facade-play');
      link.addEventListener('click', function (e) {
        e.preventDefault();
        facade.classList.add('is-loading');
        loadPlyr().then(function () {
          facade.classList.remove('video-facade', 'is-loading');
          facade.replaceChildren();
          new Plyr(facade, {
            autoplay: true,
            iconUrl: base + 'plyr.svg',
            blankVideo: base + 'blank.mp4',
            disableContextMenu: 0,
            youtube: {
              noCookie: 1,
              modestbranding: 1,
              showinfo: 0,
              controls: 0,
            },
          });
        }, function () {
          window.location.href = link.href;
        });
      });
    });
  })();
</script>
