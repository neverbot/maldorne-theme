<div class="container">
    <article class="post-wrap page">
        <% if (theme.page_title_enable){ %>
        <h2 class="post-title"><%- page.title %></h2>
        <% } %>
        <section class="post-content">
            <%- page.content %>
            <iframe id="maldorneFrame" title="<%= page.title %>" width="800" height="600"></iframe>
            <script>
                document.getElementById('maldorneFrame').src =
                    'https://play.maldorne.org/' + (location.search || '?mud=hexagon-en');
            </script>
        </section>
    </article>
</div>
